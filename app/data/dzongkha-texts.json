{
  "beginner": [
    {
      "id": "beginner-001",
      "text": "ཀ་ཁ་ག་ང་།ཅ་ཆ་ཇ་ཉ་།ཏ་ཐ་ད་ན་།པ་ཕ་བ་མ་། "
    },
    {
      "id": "beginner-002",
      "text": "ང་ཁྱིམ་ནང་ཡོད།ཁྱོད་ག་ཏེ་ཡོད།"
    },
    {
      "id": "beginner-003",
      "text": "འབྲུག་ཡུལ།རྫོང་ཁ།བཀྲ་ཤིས།"
    }
  ],
  "intermediate": [
    {
      "id": "intermediate-001",
      "text": "ང་བཅས་ར་ཉིནམ་ཨ་རྟག་ར་རྫོང་ཁ་འབྲི་ནིའི་སྦྱང་བ་འབད་གེ།"
    },
    {
      "id": "intermediate-002",
      "text": "ཁྱོད་ག་དེ་སྦེ་ཡོད།ང་ལེགས་ཤོམ་སྦེ་ཡོད།བཀའ་དྲིན་ཆེ།"
    }
  ],
  "expert": [
    {
      "id": "expert-001",
      "text": "རང་གི་སྐད་ཡིག་དེ་རང་གི་ངོ་རྟགས་ཨིན།རྫོང་ཁ་ལེགས་ཤོམ་སྦེ་འབྲི་ནི་འདི་གལ་ཆེ།"
    },
    {
      "id": "expert-002",
      "text": "དུས་ཚོད་ལས་འགལ་མེད་པར་ཕྱག་ཞུ་ནི་དང་འགན་ཁུར་འབག་ནི་འདི་ཁག་ཆེ།"
    }
  ]
}
